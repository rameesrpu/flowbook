{
  "name": "flowbook-monorepo",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @flowbook/core build && pnpm --filter @flowbook/resolver build && pnpm --filter @flowbook/cli build && pnpm --filter @flowbook/webview build && pnpm --filter flowbook build",
    "typecheck": "tsc -b && pnpm --filter flowbook typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "flowbook": "node packages/cli/dist/flowbook.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "type": "module"
}
