{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flowbook records (one JSON object per JSONL line)",
  "$defs": {
    "flowLine": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "flow"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "description": "Must match the file name (flows/<id>.jsonl)"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "summary": {
              "type": "string",
              "description": "Markdown text"
            },
            "entry": {
              "description": "Node id where the scenario starts",
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "layout": {
              "type": "object",
              "properties": {
                "direction": {
                  "type": "string",
                  "enum": [
                    "LR",
                    "TB"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "id",
            "title"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "node"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "notes": {
              "type": "string",
              "description": "Markdown text"
            },
            "anchor": {
              "description": "Omit for external actors (kernel, database, peer, user)",
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Repo-relative path to the source file, e.g. \"src/net/tls.c\""
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Qualified symbol name, e.g. \"parse_header\" or \"net::TlsSession::handshake\""
                },
                "sig": {
                  "description": "Parameter types to pick one overload, e.g. \"(const char*, size_t)\"",
                  "type": "string"
                }
              },
              "required": [
                "file",
                "symbol"
              ],
              "additionalProperties": false
            },
            "fp": {
              "description": "Body fingerprint written by `flowbook stamp`; do not edit by hand",
              "type": "string"
            },
            "verified": {
              "description": "Commit SHA the fingerprint was taken at; written by `flowbook stamp`",
              "type": "string"
            },
            "flow": {
              "description": "Id of another flow that details this node (drill-down)",
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          },
          "required": [
            "kind",
            "id",
            "title"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "step"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "seq": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "Order within the flow, starting at 1"
            },
            "from": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "to": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "description": "What happens and why, not just the callee name"
            },
            "type": {
              "default": "call",
              "type": "string",
              "enum": [
                "call",
                "return",
                "async",
                "callback",
                "signal"
              ]
            },
            "guard": {
              "description": "Condition under which this step happens",
              "type": "string"
            },
            "notes": {
              "type": "string",
              "description": "Markdown text"
            }
          },
          "required": [
            "kind",
            "id",
            "seq",
            "from",
            "to",
            "label"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "block"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "type": {
              "type": "string",
              "enum": [
                "loop",
                "alt",
                "par"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "description": "e.g. \"for each packet\", \"auth result\", \"worker threads\""
            },
            "steps": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              }
            }
          },
          "required": [
            "kind",
            "id",
            "type",
            "label",
            "steps"
          ],
          "additionalProperties": false
        }
      ]
    },
    "configLine": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "config"
            },
            "version": {
              "type": "number",
              "const": 1
            }
          },
          "required": [
            "kind",
            "version"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "group"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Component name shown in diagrams, e.g. \"Networking\""
            },
            "paths": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Globs, e.g. [\"src/net/**\"]"
            }
          },
          "required": [
            "kind",
            "name",
            "paths"
          ],
          "additionalProperties": false
        }
      ]
    },
    "connectionsLine": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rule"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "type": "string",
              "enum": [
                "queue",
                "event",
                "timer",
                "callback",
                "request"
              ],
              "description": "For display only"
            },
            "send": {
              "minItems": 1,
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "call": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Regular expression that must match the whole name"
                      },
                      "key": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991,
                        "description": "1-based argument position"
                      },
                      "handler": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991,
                        "description": "1-based argument position"
                      },
                      "keyMember": {
                        "description": "Take the field or variable name of the key argument (x->mbox gives mbox)",
                        "type": "boolean",
                        "const": true
                      },
                      "keys": {
                        "description": "Regular expression the derived key must match entirely",
                        "type": "string",
                        "minLength": 1
                      },
                      "files": {
                        "description": "Globs limiting where it applies",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "call"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "case": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Regular expression that must match the whole name"
                      },
                      "files": {
                        "description": "Globs limiting where it applies",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "case"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "test": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Regular expression that must match the whole name"
                      },
                      "files": {
                        "description": "Globs limiting where it applies",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "test"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "assign": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Regular expression that must match the whole name"
                      },
                      "as": {
                        "type": "string",
                        "enum": [
                          "key",
                          "handler"
                        ]
                      },
                      "keyMember": {
                        "description": "Take the field or variable name of the key argument (x->mbox gives mbox)",
                        "type": "boolean",
                        "const": true
                      },
                      "keys": {
                        "description": "Regular expression the derived key must match entirely",
                        "type": "string",
                        "minLength": 1
                      },
                      "files": {
                        "description": "Globs limiting where it applies",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "assign",
                      "as"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "invoke": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Regular expression that must match the whole name"
                      },
                      "files": {
                        "description": "Globs limiting where it applies",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "invoke"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "receive": {
              "description": "Omit when every send names a handler",
              "minItems": 1,
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "call": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Regular expression that must match the whole name"
                      },
                      "key": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991,
                        "description": "1-based argument position"
                      },
                      "handler": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991,
                        "description": "1-based argument position"
                      },
                      "keyMember": {
                        "description": "Take the field or variable name of the key argument (x->mbox gives mbox)",
                        "type": "boolean",
                        "const": true
                      },
                      "keys": {
                        "description": "Regular expression the derived key must match entirely",
                        "type": "string",
                        "minLength": 1
                      },
                      "files": {
                        "description": "Globs limiting where it applies",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "call"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "case": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Regular expression that must match the whole name"
                      },
                      "files": {
                        "description": "Globs limiting where it applies",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "case"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "test": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Regular expression that must match the whole name"
                      },
                      "files": {
                        "description": "Globs limiting where it applies",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "test"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "assign": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Regular expression that must match the whole name"
                      },
                      "as": {
                        "type": "string",
                        "enum": [
                          "key",
                          "handler"
                        ]
                      },
                      "keyMember": {
                        "description": "Take the field or variable name of the key argument (x->mbox gives mbox)",
                        "type": "boolean",
                        "const": true
                      },
                      "keys": {
                        "description": "Regular expression the derived key must match entirely",
                        "type": "string",
                        "minLength": 1
                      },
                      "files": {
                        "description": "Globs limiting where it applies",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "assign",
                      "as"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "invoke": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Regular expression that must match the whole name"
                      },
                      "files": {
                        "description": "Globs limiting where it applies",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "invoke"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "context": {
              "description": "Where reactors run, e.g. \"master thread\"",
              "type": "string"
            },
            "notes": {
              "type": "string",
              "description": "Markdown text"
            }
          },
          "required": [
            "kind",
            "id",
            "title",
            "type",
            "send"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "connection"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "rule": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "description": "Id of the rule it belongs to"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "description": "Keyed form",
              "type": "string",
              "minLength": 1
            },
            "send": {
              "description": "Anchored form: functions containing send sites",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Repo-relative path to the source file, e.g. \"src/net/tls.c\""
                  },
                  "symbol": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Qualified symbol name, e.g. \"parse_header\" or \"net::TlsSession::handshake\""
                  },
                  "sig": {
                    "description": "Parameter types to pick one overload, e.g. \"(const char*, size_t)\"",
                    "type": "string"
                  }
                },
                "required": [
                  "file",
                  "symbol"
                ],
                "additionalProperties": false
              }
            },
            "receive": {
              "description": "Anchored form: functions containing receive sites",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Repo-relative path to the source file, e.g. \"src/net/tls.c\""
                  },
                  "symbol": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Qualified symbol name, e.g. \"parse_header\" or \"net::TlsSession::handshake\""
                  },
                  "sig": {
                    "description": "Parameter types to pick one overload, e.g. \"(const char*, size_t)\"",
                    "type": "string"
                  }
                },
                "required": [
                  "file",
                  "symbol"
                ],
                "additionalProperties": false
              }
            },
            "context": {
              "type": "string"
            },
            "notes": {
              "type": "string",
              "description": "Markdown text"
            }
          },
          "required": [
            "kind",
            "id",
            "rule",
            "title"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
