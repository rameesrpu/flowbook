{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flowbook records (one JSON object per JSONL line)",
  "$defs": {
    "flowLine": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "flow"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "description": "Must match the file name (flows/<id>.jsonl)"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "summary": {
              "type": "string",
              "description": "Markdown text"
            },
            "entry": {
              "description": "Node id where the scenario starts",
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "layout": {
              "type": "object",
              "properties": {
                "direction": {
                  "type": "string",
                  "enum": [
                    "LR",
                    "TB"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "id",
            "title"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "node"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "notes": {
              "type": "string",
              "description": "Markdown text"
            },
            "anchor": {
              "description": "Omit for external actors (kernel, database, peer, user)",
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Repo-relative path to the source file, e.g. \"src/net/tls.c\""
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Qualified symbol name, e.g. \"parse_header\" or \"net::TlsSession::handshake\""
                },
                "sig": {
                  "description": "Parameter types to pick one overload, e.g. \"(const char*, size_t)\"",
                  "type": "string"
                }
              },
              "required": [
                "file",
                "symbol"
              ],
              "additionalProperties": false
            },
            "fp": {
              "description": "Body fingerprint written by `flowbook stamp`; do not edit by hand",
              "type": "string"
            },
            "verified": {
              "description": "Commit SHA the fingerprint was taken at; written by `flowbook stamp`",
              "type": "string"
            },
            "flow": {
              "description": "Id of another flow that details this node (drill-down)",
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          },
          "required": [
            "kind",
            "id",
            "title"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "step"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "seq": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "Order within the flow, starting at 1"
            },
            "from": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "to": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "description": "What happens and why, not just the callee name"
            },
            "type": {
              "default": "call",
              "type": "string",
              "enum": [
                "call",
                "return",
                "async",
                "callback",
                "signal"
              ]
            },
            "guard": {
              "description": "Condition under which this step happens",
              "type": "string"
            },
            "notes": {
              "type": "string",
              "description": "Markdown text"
            }
          },
          "required": [
            "kind",
            "id",
            "seq",
            "from",
            "to",
            "label"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "block"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "type": {
              "type": "string",
              "enum": [
                "loop",
                "alt",
                "par"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "description": "e.g. \"for each packet\", \"auth result\", \"worker threads\""
            },
            "steps": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              }
            }
          },
          "required": [
            "kind",
            "id",
            "type",
            "label",
            "steps"
          ],
          "additionalProperties": false
        }
      ]
    },
    "configLine": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "config"
            },
            "version": {
              "type": "number",
              "const": 1
            }
          },
          "required": [
            "kind",
            "version"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "group"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Component name shown in diagrams, e.g. \"Networking\""
            },
            "paths": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Globs, e.g. [\"src/net/**\"]"
            }
          },
          "required": [
            "kind",
            "name",
            "paths"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
